# Application
APP_NAME="Payment Gateway Demo"
DEBUG=false
ENVIRONMENT=development

# Security - configure for production
# CORS_ORIGINS: JSON array, e.g. ["http://localhost:8000","https://yourdomain.com"]
# RATE_LIMIT: global limit, e.g. 100/minute
# RATE_LIMIT_PAYMENT: stricter limit for payment endpoints, e.g. 10/minute

# Admin / SIEM dashboard at /admin — send this value as header X-Admin-Token from the UI
ADMIN_API_KEY=change-me-in-production
# SIEM thresholds (requests per IP per rolling 60s window)
SIEM_SUSPICIOUS_RPM=60
SIEM_CRITICAL_RPM=200
